# Pins for the "thin kernel" build (sourced by thin/build.sh; plain KEY=value, no spaces around =).
# 2026-10-30: first written. Every external input is pinned by commit SHA or sha256; build.sh refuses a
# mismatch. To update the maintainer base, change KERNEL_SHA + VANILLASU_SHA together (see README "Monthly update").

# Maintainer's kernel tree: the build flashed on the phone on 2026-10-27 (CI run 40575009384).
KERNEL_URL=https://github.com/vanilla-kernel/VanillaKernel
KERNEL_SHA=e615f34c7dcbdd6bbc9290692c02b780391dc89a
# Root manager (KernelSU-Next fork). It is a git submodule of the kernel tree; the kernel's gitlink must equal this.
VANILLASU_URL=https://github.com/vanilla-kernel/VanillaSU.git
VANILLASU_SHA=1fadf987e86ceb4a5439be75cee8eac75a0fdaa0

# Toolchain: AOSP prebuilt clang r416183b, exactly as the maintainer's CI fetches it.
CLANG_NAME=clang-r416183b
CLANG_URL=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/b669748458572622ed716407611633c5415da25c/clang-r416183b.tar.gz
CLANG_SHA256=fd5efc3c90d9f60c83414bac457beada63d0c67c61a811527749911fe1254abd

# moby's check-config.sh (Docker's own kernel-option checker), pinned to a commit.
CHECKCONFIG_URL=https://raw.githubusercontent.com/moby/moby/a4c5b2be6f69f86fe7b13eb4822676f8d273cf8b/contrib/check-config.sh
CHECKCONFIG_SHA256=fda4343e9b50c47896653ca774ccbe9614bfcdb60f080d2b6277baf27efc0a71

# Reference for the apk_sign.c fix: KernelSU-Next legacy branch, which carries tiann/KernelSU e6cc0ef7b0 + aa08b390cd.
APKSIGN_REF_URL=https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/165b87fa99abfe78058c4dc9df43c432e86b8011/kernel/manager/apk_sign.c
APKSIGN_REF_SHA256=c540e1f1d19e9e54b39134d96fee29f7ecbd3ba6480e8ef4f6b47a06138e89aa

# Build container base (same distro as the maintainer's CI runner, ubuntu-22.04), pinned by digest.
BUILD_BASE_IMAGE=ubuntu@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11

# The maintainer's recipe (their .github/workflows/build.yml): base defconfig + their fragment.
BASE_DEFCONFIG=vendor/lahaina-qgki_defconfig
FRAGMENT_DEFCONFIG=arch/arm64/configs/vanillaKernel-defconfig
