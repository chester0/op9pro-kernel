# Pins for the second source of thin/build.sh: the ROM's own kernel, Levion (EvolutionX 17 on the OnePlus 9 Pro).
# Use:  PINS_FILE=thin/pins-levion.env thin/build.sh all
# 2026-10-31: first written. Same rules as pins.env: every external input is pinned by commit SHA or sha256 and
# build.sh refuses a mismatch. RECIPE=levion selects Levion's own build (its .github/compile.sh), not the maintainer's.

RECIPE=levion
# Work folder of this source's tree under THIN_HOME/src, so the two sources never overwrite each other.
KERNEL_DIRNAME=kernel-levion

# Levion kernel, branch aox-ksun (KernelSU-Next + SUSFS, the build EvolutionX 17 ships), tip on 2026-10-31.
# No git submodules (KernelSU-Next lives in drivers/staging/ksu-next), so there is no VANILLASU_* pin.
KERNEL_URL=https://github.com/varakumar02/Levion_kernel_OP9
KERNEL_SHA=7eee06f3df8879c36a355491e21a5b3a1d9d3dc9

# Toolchain: AOSP prebuilt clang r547379 (clang 20.0.0), the one Levion's compile.sh pulls (CLANG_VERSION).
# URL: that clang directory at the prebuilts main commit of 2026-10-31. CLANG_TREE_SHA256 is the digest of the
# extracted tree, taken from the first download on 2026-10-31 (trust on first use; the maintainer's pins.env
# documents why a tarball sha256 cannot be pinned).
CLANG_NAME=clang-r547379
CLANG_URL=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/70a12c4fe88940ab2b0e6d763492dffa2f07e15a/clang-r547379.tar.gz
CLANG_TREE_SHA256=531462a559d88c0eb9fbda8dedded688c3aa0d4e5a78b1b2e2adda1fb4c21e73

# moby's check-config.sh, same pin as pins.env.
CHECKCONFIG_URL=https://raw.githubusercontent.com/moby/moby/a4c5b2be6f69f86fe7b13eb4822676f8d273cf8b/contrib/check-config.sh
CHECKCONFIG_SHA256=fda4343e9b50c47896653ca774ccbe9614bfcdb60f080d2b6277baf27efc0a71

# Build container base, same as pins.env.
BUILD_BASE_IMAGE=ubuntu@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11

# Levion's recipe: its base defconfig (compile.sh: "vendor/lahaina-qgki_defconfig") plus our Docker fragment.
BASE_DEFCONFIG=vendor/lahaina-qgki_defconfig
FRAGMENT_DEFCONFIG=fragments/levion-docker.config
